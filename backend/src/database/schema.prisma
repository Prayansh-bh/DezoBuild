  createdBy          User                 @relation("ApprovalPolicyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  previousPolicy     ApprovalPolicy?      @relation("PolicyLineage", fields: [previousPolicyId], references: [id], onDelete: Restrict)
  supersededPolicies ApprovalPolicy[]     @relation("PolicyLineage")
  steps              ApprovalPolicyStep[]

  @@index([tenantId, entityType, status])
  @@index([tenantId, projectId])
  @@map("approval_policies")
}

model ApprovalPolicyStep {
  id                      String         @id @default(uuid()) @db.Uuid
  policyId                String         @map("policy_id") @db.Uuid
  stepOrder               Int            @map("step_order")
  stepName                String         @map("step_name") @db.VarChar(100)
  requiredRoleHint        String?        @map("required_role_hint") @db.VarChar(50)
  requiredPermission      String         @map("required_permission") @db.VarChar(100)
  enforceMakerChecker     Boolean        @default(true) @map("enforce_maker_checker")
  enforceDistinctFromPrev Boolean        @default(false) @map("enforce_distinct_from_prev")
  timeoutHours            Int?           @map("timeout_hours")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz

  policy                  ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([policyId, stepOrder])
  @@map("approval_policy_steps")
}

model ApprovalRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  projectId          String?               @map("project_id") @db.Uuid
  requestNumber      String                @map("request_number") @db.VarChar(100)
  entityType         ApprovalEntityType    @map("entity_type")
  entityId           String                @map("entity_id") @db.Uuid
  title              String                @db.VarChar(255)
  monetaryAmount     Decimal?              @map("monetary_amount") @db.Decimal(15, 2)
  currency           String                @default("INR") @db.VarChar(10)
  status             ApprovalRequestStatus @default(SUBMITTED)
  currentStepOrder   Int                   @default(1) @map("current_step_order")
  totalSteps         Int                   @map("total_steps")
  submittedById      String                @map("submitted_by_id") @db.Uuid
  submittedAt        DateTime              @default(now()) @map("submitted_at") @db.Timestamptz
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz
  policySnapshot     Json                  @map("policy_snapshot")
  submissionRemarks  String?               @map("submission_remarks") @db.Text
  previousRequestId  String?               @map("previous_request_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  submittedBy     User               @relation("ApprovalRequestSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  previousRequest ApprovalRequest?   @relation("ApprovalResubmission", fields: [previousRequestId], references: [id], onDelete: Restrict)
  resubmissions   ApprovalRequest[]  @relation("ApprovalResubmission")
  steps           ApprovalStep[]
  decisions       ApprovalDecision[]

  @@unique([tenantId, requestNumber])
  @@index([tenantId, projectId, status])
  @@index([tenantId, entityType, entityId])
  @@map("approval_requests")
}

model ApprovalStep {
  id                 String             @id @default(uuid()) @db.Uuid
  requestId          String             @map("request_id") @db.Uuid
  stepOrder          Int                @map("step_order")
  stepName           String             @map("step_name") @db.VarChar(100)
  requiredRoleHint   String?            @map("required_role_hint") @db.VarChar(50)
  requiredPermission String             @map("required_permission") @db.VarChar(100)
  status             ApprovalStepStatus @default(PENDING)
  assignedUserId     String?            @map("assigned_user_id") @db.Uuid
  dueAt              DateTime?          @map("due_at") @db.Timestamptz
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz

  request            ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  decisions          ApprovalDecision[]

  @@unique([requestId, stepOrder])
  @@index([requestId, status])
  @@map("approval_steps")
}

model ApprovalDecision {
  id             String               @id @default(uuid()) @db.Uuid
  requestId      String               @map("request_id") @db.Uuid
  stepId         String?              @map("step_id") @db.Uuid
  stepOrder      Int                  @map("step_order")
  actorId        String               @map("actor_id") @db.Uuid
  decision       ApprovalDecisionType
  decisionReason String?              @map("decision_reason") @db.Text
  policyContext  Json?                @map("policy_context")
  previousState  String               @map("previous_state") @db.VarChar(50)
  resultingState String               @map("resulting_state") @db.VarChar(50)
  ipAddress      String?              @map("ip_address") @db.VarChar(45)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  request        ApprovalRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  step           ApprovalStep?        @relation(fields: [stepId], references: [id], onDelete: Restrict)
  actor          User                 @relation("ApprovalDecisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
  @@map("approval_decisions")
}

// ==========================================
// PHASE 16 — ALERTS, DURABLE OUTBOX & REPORTS
// ==========================================

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WEBHOOK
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  eventType      String            @map("event_type") @db.VarChar(100)
  aggregateType  String            @map("aggregate_type") @db.VarChar(100)
  aggregateId    String            @map("aggregate_id") @db.VarChar(100)
  projectId      String?           @map("project_id") @db.Uuid
  branchId       String?           @map("branch_id") @db.Uuid
  payload        Json
  correlationId  String?           @map("correlation_id") @db.VarChar(100)
  causationId    String?           @map("causation_id") @db.VarChar(100)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(255)
  status         OutboxEventStatus @default(PENDING)
  availableAt    DateTime          @default(now()) @map("available_at") @db.Timestamptz
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5) @map("max_attempts")
  processedAt    DateTime?         @map("processed_at") @db.Timestamptz
  failedAt       DateTime?         @map("failed_at") @db.Timestamptz
  lastError      String?           @map("last_error") @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  branch         Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  alerts         Alert[]
  notifications  NotificationDelivery[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, availableAt])
  @@index([status, availableAt, attempts])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([correlationId])
  @@map("outbox_events")
}

model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  projectId        String?       @map("project_id") @db.Uuid
  branchId         String?       @map("branch_id") @db.Uuid
  alertType        String        @map("alert_type") @db.VarChar(100)
  severity         AlertSeverity @default(INFO)
  status           AlertStatus   @default(OPEN)
  title            String        @db.VarChar(255)
  message          String        @db.Text
  entityType       String?       @map("entity_type") @db.VarChar(100)
  entityId         String?       @map("entity_id") @db.VarChar(100)
  sourceEventId    String?       @map("source_event_id") @db.Uuid
  assignedToId     String?       @map("assigned_to_id") @db.Uuid
  dueAt            DateTime?     @map("due_at") @db.Timestamptz
  acknowledgedAt   DateTime?     @map("acknowledged_at") @db.Timestamptz
  acknowledgedById String?       @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz
  resolvedById     String?       @map("resolved_by_id") @db.Uuid
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project          Project?               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  branch           Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sourceEvent      OutboxEvent?           @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  assignedTo       User?                  @relation("AlertAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  acknowledgedBy   User?                  @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  resolvedBy       User?                  @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  notifications    NotificationDelivery[]

  @@unique([tenantId, sourceEventId])
  @@index([tenantId, status, severity])
  @@index([tenantId, projectId, status])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, alertType, createdAt])
  @@map("alerts")
}

model NotificationDelivery {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  alertId         String?                    @map("alert_id") @db.Uuid
  eventId         String?                    @map("event_id") @db.Uuid
  recipientUserId String                     @map("recipient_user_id") @db.Uuid
  channel         NotificationChannel        @default(IN_APP)
  status          NotificationDeliveryStatus @default(PENDING)
  title           String                     @db.VarChar(255)
  body            String                     @db.Text
  readAt          DateTime?                  @map("read_at") @db.Timestamptz
  attempts        Int                        @default(0)
  deliveredAt     DateTime?                  @map("delivered_at") @db.Timestamptz
  failedAt        DateTime?                  @map("failed_at") @db.Timestamptz
  lastError       String?                    @map("last_error") @db.Text
  metadata        Json?
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  alert           Alert?                     @relation(fields: [alertId], references: [id], onDelete: Restrict)
  event           OutboxEvent?               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  recipient       User                       @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, alertId, recipientUserId, channel])
  @@unique([tenantId, eventId, recipientUserId, channel])
  @@index([tenantId, recipientUserId, readAt])
  @@index([tenantId, recipientUserId, createdAt])
  @@index([tenantId, status, channel])
  @@index([alertId, recipientUserId])
  @@map("notification_deliveries")
}

// ==========================================
// PHASE 17: EXTERNAL INTEGRATIONS & AI CONTROL LAYER
// ==========================================

enum IntegrationType {
  ERP
  ACCOUNTING
  DOCUMENT_STORAGE
  EMAIL
  SMS
  WHATSAPP
  PAYMENTS
  BIOMETRIC
  TELEMATICS
  WEBHOOK
  CUSTOM_API
}

enum IntegrationConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
  DISCONNECTED
}

enum IntegrationSyncDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationSyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum WebhookEventStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  PROCESSED
  FAILED
  QUARANTINED
}

enum AIRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AIInsightStatus {
  ACTIVE
  ACKNOWLEDGED
  DISMISSED
  EXPIRED
}

enum AIInsightSeverity {
  INFO
  WARNING
  CRITICAL
}

model IntegrationConnection {
  id              String                      @id @default(uuid()) @db.Uuid
  tenantId        String                      @map("tenant_id") @db.Uuid
  integrationType IntegrationType             @map("integration_type")
  providerKey     String                      @map("provider_key") @db.VarChar(100)
  name            String                      @db.VarChar(255)
  status          IntegrationConnectionStatus @default(ACTIVE)
  config          Json
  encryptedSecret String?                     @map("encrypted_secret") @db.Text
  secretRef       String?                     @map("secret_ref") @db.VarChar(255)
  createdById     String                      @map("created_by_id") @db.Uuid
  lastConnectedAt DateTime?                   @map("last_connected_at") @db.Timestamptz
  lastSyncAt      DateTime?                   @map("last_sync_at") @db.Timestamptz
  lastError       String?                     @map("last_error") @db.Text
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy          User                 @relation("IntegrationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  syncJobs           IntegrationSyncJob[]
  externalReferences ExternalReference[]

  @@unique([tenantId, providerKey, name])
  @@index([tenantId, status, integrationType])
  @@index([providerKey, status])
  @@map("integration_connections")
}

model ExternalReference {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  integrationConnectionId String   @map("integration_connection_id") @db.Uuid
  entityType              String   @map("entity_type") @db.VarChar(100)
  entityId                String   @map("entity_id") @db.VarChar(100)
  externalEntityType      String   @map("external_entity_type") @db.VarChar(100)
  externalEntityId        String   @map("external_entity_id") @db.VarChar(255)
  externalVersion         String?  @map("external_version") @db.VarChar(100)
  lastSyncedAt            DateTime? @map("last_synced_at") @db.Timestamptz
  syncStatus              String   @default("SYNCED") @map("sync_status") @db.VarChar(50)
  metadata                Json?
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connection IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, integrationConnectionId, entityType, entityId])
  @@unique([tenantId, integrationConnectionId, externalEntityType, externalEntityId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, externalEntityType, externalEntityId])
  @@map("external_references")
}

model IntegrationSyncJob {
  id                      String                   @id @default(uuid()) @db.Uuid
  tenantId                String                   @map("tenant_id") @db.Uuid
  integrationConnectionId String                   @map("integration_connection_id") @db.Uuid
  direction               IntegrationSyncDirection @default(OUTBOUND)
  entityType              String                   @map("entity_type") @db.VarChar(100)
  scopeMetadata           Json?                    @map("scope_metadata")
  status                  IntegrationSyncJobStatus @default(PENDING)
  idempotencyKey          String                   @map("idempotency_key") @db.VarChar(255)
  attempts                Int                      @default(0)
  maxAttempts             Int                      @default(5) @map("max_attempts")
  availableAt             DateTime                 @default(now()) @map("available_at") @db.Timestamptz
  startedAt               DateTime?                @map("started_at") @db.Timestamptz
  completedAt             DateTime?                @map("completed_at") @db.Timestamptz
  failedAt                DateTime?                @map("failed_at") @db.Timestamptz
  lastError               String?                  @map("last_error") @db.Text
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connection IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, availableAt])
  @@index([integrationConnectionId, status])
  @@map("integration_sync_jobs")
}

model WebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  providerKey     String             @map("provider_key") @db.VarChar(100)
  externalEventId String             @map("external_event_id") @db.VarChar(255)
  tenantId        String?            @map("tenant_id") @db.Uuid
  eventType       String             @map("event_type") @db.VarChar(100)
  payload         Json
  signature       String?            @db.Text
  status          WebhookEventStatus @default(RECEIVED)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz
  failedAt        DateTime?          @map("failed_at") @db.Timestamptz
  lastError       String?            @map("last_error") @db.Text
  attempts        Int                @default(0)
  correlationId   String?            @map("correlation_id") @db.VarChar(100)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([providerKey, externalEventId])
  @@index([tenantId, status, receivedAt])
  @@index([providerKey, status])
  @@map("webhook_events")
}

model AIRequest {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  requestedById String          @map("requested_by_id") @db.Uuid
  featureKey    String          @map("feature_key") @db.VarChar(100)
  operation     String          @db.VarChar(100)
  providerKey   String          @map("provider_key") @db.VarChar(100)
  model         String          @db.VarChar(100)
  inputHash     String          @map("input_hash") @db.VarChar(64)
  status        AIRequestStatus @default(PENDING)
  startedAt     DateTime        @default(now()) @map("started_at") @db.Timestamptz
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz
  failedAt      DateTime?       @map("failed_at") @db.Timestamptz
  errorCode     String?         @map("error_code") @db.VarChar(100)
  latencyMs     Int?            @map("latency_ms")
  inputTokens   Int?            @map("input_tokens")
  outputTokens  Int?            @map("output_tokens")
  totalTokens   Int?            @map("total_tokens")
  estimatedCost Decimal?        @map("estimated_cost") @db.Decimal(12, 6)
  correlationId String?         @map("correlation_id") @db.VarChar(100)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requestedBy User        @relation("AIRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  insights    AIInsight[]

  @@index([tenantId, featureKey, createdAt])
  @@index([tenantId, requestedById, createdAt])
  @@index([providerKey, model, status])
  @@map("ai_requests")
}

model AIInsight {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  projectId        String?           @map("project_id") @db.Uuid
  featureKey       String            @map("feature_key") @db.VarChar(100)
  severity         AIInsightSeverity @default(INFO)
  title            String            @db.VarChar(255)
  summary          String            @db.Text
  evidence         Json?
  sourceReferences Json?             @map("source_references")
  confidence       Decimal?          @db.Decimal(5, 4)
  generatedBy      String            @map("generated_by") @db.VarChar(100)
  aiRequestId      String?           @map("ai_request_id") @db.Uuid
  status           AIInsightStatus   @default(ACTIVE)
  expiresAt        DateTime?         @map("expires_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  aiRequest AIRequest? @relation(fields: [aiRequestId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, severity])
  @@index([tenantId, projectId, status])
  @@index([tenantId, featureKey, createdAt])
  @@map("ai_insights")
}













