  attendanceRecord AttendanceRecord?  @relation("RecordTargetRegularizations", fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  requestedBy      User               @relation("RegularizationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy       User?              @relation("RegularizationApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  appliedRecords   AttendanceRecord[] @relation("RecordRegularization")

  @@index([tenantId, employeeId, status])
  @@index([tenantId, status])
  @@map("attendance_regularizations")
}

