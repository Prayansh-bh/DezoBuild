  requestedBy                 User                      @relation("InspectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  inspectedBy                 User?                     @relation("InspectionInspectedBy", fields: [inspectedById], references: [id], onDelete: SetNull)
  approvedBy                  User?                     @relation("InspectionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  checklistItems              InspectionChecklistItem[]
  nonConformanceReports       NonConformanceReport[]

  @@unique([tenantId, inspectionNumber])
  @@index([tenantId, projectId, status])
  @@index([tenantId, inspectionType])
  @@index([tenantId, isHoldPoint])
  @@map("inspection_requests")
}

