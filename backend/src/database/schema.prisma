model Employee {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  userId                String?   @unique @map("user_id") @db.Uuid
  employeeNumber        String    @map("employee_number") @db.VarChar(50)
  companyId             String    @map("company_id") @db.Uuid
  branchId              String?   @map("branch_id") @db.Uuid
  departmentId          String?   @map("department_id") @db.Uuid
  reportingManagerId    String?   @map("reporting_manager_id") @db.Uuid
  fullName              String    @map("full_name") @db.VarChar(255)
  email                 String?   @db.VarChar(255)
  phone                 String?   @db.VarChar(50)
  designation           String    @db.VarChar(100)
  employmentType        String    @default("FULL_TIME") @map("employment_type") @db.VarChar(50) // FULL_TIME, CONTRACT, INTERN, DAILY_WAGE, PART_TIME
  employmentStatus      String    @default("ACTIVE") @map("employment_status") @db.VarChar(50) // ACTIVE, ON_LEAVE, SUSPENDED, RESIGNED, TERMINATED, RETIRED
  joiningDate           DateTime  @map("joining_date") @db.Date
  exitDate              DateTime? @map("exit_date") @db.Date
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactPhone String?   @map("emergency_contact_phone") @db.VarChar(50)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant                 Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                   User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                 Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department             Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportingManager       Employee?                  @relation("EmployeeHierarchy", fields: [reportingManagerId], references: [id], onDelete: Restrict)
  directReports          Employee[]                 @relation("EmployeeHierarchy")
  attendancePunches      AttendancePunch[]
  attendanceRecords      AttendanceRecord[]
  regularizationRequests AttendanceRegularization[]
  leaveRecords           LeaveRecord[]
  operatedEquipmentLogs  EquipmentOperatingLog[]
  assignedQualitySafetyActions QualitySafetyAction[]
  injuredSafetyIncidents SafetyIncident[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, companyId])
  @@index([tenantId, departmentId])
  @@index([tenantId, reportingManagerId])
  @@map("employees")
}

model ShiftMaster {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  code                    String   @db.VarChar(50)
  name                    String   @db.VarChar(100)
