  gradeOrSpecification       String?   @map("grade_or_specification") @db.VarChar(100)
  plannedQuantity             Decimal?  @map("planned_quantity") @db.Decimal(12, 3)
  unit                        String?   @db.VarChar(20)
  isHoldPoint                 Boolean   @default(false) @map("is_hold_point")
  isWitnessPoint              Boolean   @default(false) @map("is_witness_point")
  requestedById               String    @map("requested_by_id") @db.Uuid
  requestedAt                 DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  plannedInspectionAt         DateTime? @map("planned_inspection_at") @db.Timestamptz
  inspectedById               String?   @map("inspected_by_id") @db.Uuid
  inspectedAt                 DateTime? @map("inspected_at") @db.Timestamptz
  status                      String    @default("DRAFT") @db.VarChar(50) // DRAFT, SUBMITTED, SCHEDULED, IN_PROGRESS, PENDING_APPROVAL, PASSED, CONDITIONALLY_PASSED, REJECTED, CANCELLED
  resultRemarks               String?   @map("result_remarks") @db.Text
  conditionalRemarks          String?   @map("conditional_remarks") @db.Text
  conditionalActionId         String?   @map("conditional_action_id") @db.Uuid
  approvedById                String?   @map("approved_by_id") @db.Uuid
  approvedAt                  DateTime? @map("approved_at") @db.Timestamptz
  rejectionReason             String?   @map("rejection_reason") @db.Text
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant                      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project                     Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  wbsNode                     WbsNode?                  @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  task                        Task?                     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  material                    Material?                 @relation(fields: [materialId], references: [id], onDelete: SetNull)
  goodsReceipt                GoodsReceiptNote?         @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  equipment                   Equipment?                @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
