// DEZOBUILD Construction Operating System - Production Prisma Schema
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// PHASE 03 — TENANCY & ENTERPRISE MASTERS
// ==========================================

model Tenant {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(50)
  name           String    @db.VarChar(255)
  domain         String?   @unique @db.VarChar(255)
  status         String    @default("ACTIVE") @db.VarChar(50) // ACTIVE, SUSPENDED, DELINQUENT
  planTier       String    @default("ENTERPRISE") @map("plan_tier") @db.VarChar(50)
  currency       String    @default("INR") @db.VarChar(10)
  currencySymbol String    @default("₹") @map("currency_symbol") @db.VarChar(10)
  timezone       String    @default("Asia/Kolkata") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  companies     Company[]
  users         User[]
  departments   Department[]
  roles                Role[]
  invitations          UserInvitation[]
  subscriptions        TenantSubscription[]
  workspaceModules     TenantWorkspaceModule[]
  dailyProgressReports DailyProgressReport[]
  stores               Store[]
  materials            Material[]
  vendors              Vendor[]
  stockBalances        StoreStockBalance[]
  stockMovements       StockMovement[]
  materialIndents      MaterialIndent[]
  materialIndentLines  MaterialIndentLine[]
  materialIndentSequences MaterialIndentSequence[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseOrderSequences PurchaseOrderSequence[]
  goodsReceiptNotes    GoodsReceiptNote[]
  goodsReceiptLines    GoodsReceiptLine[]
  goodsReceiptSequences GoodsReceiptSequence[]
  materialIssues       MaterialIssue[]
  materialIssueLines   MaterialIssueLine[]
  materialIssueSequences MaterialIssueSequence[]
  materialReturns      MaterialReturn[]
  materialReturnLines  MaterialReturnLine[]
  materialReturnSequences MaterialReturnSequence[]
  materialTransfers    MaterialTransfer[]
  materialTransferLines MaterialTransferLine[]
  materialTransferSequences MaterialTransferSequence[]
  inventoryReservations InventoryReservation[]
  inventoryReservationLines InventoryReservationLine[]
  inventoryReservationSequences InventoryReservationSequence[]
  boqItems              BoqItem[]
  digitalMbRecords      DigitalMbRecord[]
  measurementDimensions MeasurementDimension[]
  digitalMbSequences    DigitalMbSequence[]
  expenseCategories     ExpenseCategory[]
  expenseClaims         ExpenseClaim[]
  vendorInvoices        VendorInvoice[]
  vendorInvoiceLines    VendorInvoiceLine[]
  vendorInvoiceGrnAllocations VendorInvoiceGrnAllocation[]
  raBills               RaBill[]
  raBillItems           RaBillItem[]
  raBillMeasurementAllocations RaBillMeasurementAllocation[]
  raBillDeductions      RaBillDeduction[]
  paymentVouchers       PaymentVoucher[]
  paymentAllocations    PaymentAllocation[]
  advanceRecords        AdvanceRecord[]
  advanceRecoveryAllocations AdvanceRecoveryAllocation[]
  retentionRecords      RetentionRecord[]
  retentionReleaseAllocations RetentionReleaseAllocation[]
  appliedTaxLines       AppliedTaxLine[]
  financeSequences      FinanceSequence[]
  financeAuditLogs      FinanceAuditLog[]
  employees             Employee[]
  shifts                ShiftMaster[]
  attendancePunches     AttendancePunch[]
  attendanceRecords     AttendanceRecord[]
  attendanceRegularizations AttendanceRegularization[]
  labourContractors     LabourContractor[]
  labourMusterRecords   LabourMusterRecord[]
  leaveRecords          LeaveRecord[]
  holidayCalendars      HolidayCalendar[]
  peopleAuditLogs       PeopleAuditLog[]
  equipment             Equipment[]
  equipmentAssignments  EquipmentAssignment[]
  equipmentOperatingLogs EquipmentOperatingLog[]
  equipmentFuelLogs     EquipmentFuelLog[]
  maintenanceSchedules  MaintenanceSchedule[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  equipmentAuditLogs    EquipmentAuditLog[]
  inspectionRequests    InspectionRequest[]
  inspectionChecklistItems InspectionChecklistItem[]
  nonConformanceReports NonConformanceReport[]
  qualitySafetyActions  QualitySafetyAction[]
  safetyObservations    SafetyObservation[]
  safetyIncidents       SafetyIncident[]
  qualitySafetyAuditLogs QualitySafetyAuditLog[]
  engineeringDocuments  EngineeringDocument[]
  documentVersions      DocumentVersion[]
  documentTransmittals  DocumentTransmittal[]
  documentTransmittalItems DocumentTransmittalItem[]
  rfis                  RequestForInformation[]
  rfiDocumentReferences RfiDocumentReference[]
  documentAuditLogs     DocumentAuditLog[]
  approvalPolicies      ApprovalPolicy[]
  approvalRequests      ApprovalRequest[]
  outboxEvents          OutboxEvent[]
  alerts                Alert[]
  notificationDeliveries NotificationDelivery[]
  integrationConnections IntegrationConnection[]
  externalReferences    ExternalReference[]
  integrationSyncJobs   IntegrationSyncJob[]
  webhookEvents         WebhookEvent[]
  aiRequests            AIRequest[]
  aiInsights            AIInsight[]

  @@index([status])
  @@map("tenants")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  legalName String   @map("legal_name") @db.VarChar(255)
  cinNumber String?  @map("cin_number") @db.VarChar(50)
  panNumber String   @map("pan_number") @db.VarChar(50)
  gstin     String   @db.VarChar(50)
  email     String   @db.VarChar(255)
  phone     String   @db.VarChar(50)
  address   String   @db.Text
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  pincode   String   @db.VarChar(20)
  status    String   @default("ACTIVE") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches Branch[]
  projects Project[]
  employees Employee[]
  equipment Equipment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  gstin     String   @db.VarChar(50)
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  status    String   @default("ACTIVE") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees        Employee[]
  holidayCalendars HolidayCalendar[]
  stationedEquipment Equipment[]
  outboxEvents       OutboxEvent[]
  alerts             Alert[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("branches")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

// ==========================================
// PHASE 02 — IDENTITY & AUTHENTICATION
// ==========================================

model User {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  email          String    @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  fullName       String    @map("full_name") @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  status         String    @default("ACTIVE") @db.VarChar(50) // ACTIVE, SUSPENDED, INVITED
  sessionVersion Int       @default(1) @map("session_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions         Session[]
  roleAssignments  UserRoleAssignment[]
  projectMembers   ProjectMember[]
  storeAssignments StoreAccessAssignment[]
  assignedTasks    Task[]

  createdDprs      DailyProgressReport[]   @relation("DprCreatedBy")
  submittedDprs    DailyProgressReport[]   @relation("DprSubmittedBy")
  approvedDprs     DailyProgressReport[]   @relation("DprApprovedBy")
  rejectedDprs     DailyProgressReport[]   @relation("DprRejectedBy")
  uploadedDprPhotos DprPhoto[]
  stockMovements   StockMovement[]
  createdIndents   MaterialIndent[]        @relation("IndentCreatedBy")
  submittedIndents MaterialIndent[]        @relation("IndentSubmittedBy")
  approvedIndents  MaterialIndent[]        @relation("IndentApprovedBy")
  rejectedIndents  MaterialIndent[]        @relation("IndentRejectedBy")
  cancelledIndents MaterialIndent[]        @relation("IndentCancelledBy")
  createdPurchaseOrders   PurchaseOrder[]   @relation("PoCreatedBy")
  submittedPurchaseOrders PurchaseOrder[]   @relation("PoSubmittedBy")
  approvedPurchaseOrders  PurchaseOrder[]   @relation("PoApprovedBy")
  rejectedPurchaseOrders  PurchaseOrder[]   @relation("PoRejectedBy")
  cancelledPurchaseOrders PurchaseOrder[]   @relation("PoCancelledBy")
  orderedPurchaseOrders   PurchaseOrder[]   @relation("PoOrderedBy")
  receivedGoodsReceipts   GoodsReceiptNote[] @relation("GrnReceivedBy")
  submittedGoodsReceipts  GoodsReceiptNote[] @relation("GrnSubmittedBy")
  verifiedGoodsReceipts   GoodsReceiptNote[] @relation("GrnVerifiedBy")
  rejectedGoodsReceipts   GoodsReceiptNote[] @relation("GrnRejectedBy")
  cancelledGoodsReceipts  GoodsReceiptNote[] @relation("GrnCancelledBy")
  requestedMaterialIssues MaterialIssue[]   @relation("IssueRequestedBy")
  issuedMaterialIssues    MaterialIssue[]   @relation("IssueIssuedBy")
  approvedMaterialIssues  MaterialIssue[]   @relation("IssueApprovedBy")
  cancelledMaterialIssues MaterialIssue[]   @relation("IssueCancelledBy")
  returnsSubmitted        MaterialReturn[]  @relation("ReturnReturnedBy")
  returnsVerified         MaterialReturn[]  @relation("ReturnVerifiedBy")
  transfersCreated        MaterialTransfer[] @relation("TransferCreatedBy")
  transfersSubmitted      MaterialTransfer[] @relation("TransferSubmittedBy")
  transfersApproved       MaterialTransfer[] @relation("TransferApprovedBy")
  transfersDispatched     MaterialTransfer[] @relation("TransferDispatchedBy")
  transfersReceived       MaterialTransfer[] @relation("TransferReceivedBy")
  transfersRejected       MaterialTransfer[] @relation("TransferRejectedBy")
  transfersCancelled      MaterialTransfer[] @relation("TransferCancelledBy")
  createdReservations     InventoryReservation[] @relation("ReservationCreatedBy")
  submittedReservations   InventoryReservation[] @relation("ReservationSubmittedBy")
  approvedReservations    InventoryReservation[] @relation("ReservationApprovedBy")
  releasedReservations    InventoryReservation[] @relation("ReservationReleasedBy")
  cancelledReservations   InventoryReservation[] @relation("ReservationCancelledBy")
  rejectedReservations    InventoryReservation[] @relation("ReservationRejectedBy")
  createdBoqItems         BoqItem[]              @relation("BoqCreatedBy")
  createdMbRecords        DigitalMbRecord[]      @relation("MbCreatedBy")
  submittedMbRecords      DigitalMbRecord[]      @relation("MbSubmittedBy")
  verifiedMbRecords       DigitalMbRecord[]      @relation("MbVerifiedBy")
  approvedMbRecords       DigitalMbRecord[]      @relation("MbApprovedBy")
  rejectedMbRecords       DigitalMbRecord[]      @relation("MbRejectedBy")
  submittedExpenseClaims  ExpenseClaim[]         @relation("ExpenseSubmittedBy")
  approvedExpenseClaims   ExpenseClaim[]         @relation("ExpenseApprovedBy")
  createdInvoices         VendorInvoice[]        @relation("InvoiceCreatedBy")
  verifiedInvoices        VendorInvoice[]        @relation("InvoiceVerifiedBy")
  approvedInvoices        VendorInvoice[]        @relation("InvoiceApprovedBy")
  createdRaBills          RaBill[]               @relation("RaBillCreatedBy")
  verifiedRaBills         RaBill[]               @relation("RaBillVerifiedBy")
  approvedRaBills         RaBill[]               @relation("RaBillApprovedBy")
  createdPaymentVouchers  PaymentVoucher[]       @relation("VoucherCreatedBy")
  disbursedPaymentVouchers PaymentVoucher[]      @relation("VoucherDisbursedBy")
  employeeAdvances        AdvanceRecord[]        @relation("AdvanceEmployee")
  employee                Employee?
  regularizationsRequested AttendanceRegularization[] @relation("RegularizationRequestedBy")
  regularizationsApproved AttendanceRegularization[] @relation("RegularizationApprovedBy")
  leavesApproved          LeaveRecord[]              @relation("LeaveApprovedBy")
  mustersRecorded         LabourMusterRecord[]       @relation("MusterRecordedBy")
  mustersApproved         LabourMusterRecord[]       @relation("MusterApprovedBy")
  assignedEquipment       EquipmentAssignment[]      @relation("AssignmentAssignedBy")
  recordedOperatingLogs   EquipmentOperatingLog[]    @relation("OpLogRecordedBy")
  correctedOperatingLogs  EquipmentOperatingLog[]    @relation("OpLogCorrectedBy")
  dispensedFuelLogs       EquipmentFuelLog[]         @relation("FuelDispensedBy")
  reportedWorkOrders      MaintenanceWorkOrder[]     @relation("WoReportedBy")
  completedWorkOrders     MaintenanceWorkOrder[]     @relation("WoCompletedBy")
  requestedInspections    InspectionRequest[]        @relation("InspectionRequestedBy")
  inspectedInspections    InspectionRequest[]        @relation("InspectionInspectedBy")
  approvedInspections     InspectionRequest[]        @relation("InspectionApprovedBy")
  raisedNcrs              NonConformanceReport[]     @relation("NcrRaisedBy")
  verifiedNcrs            NonConformanceReport[]     @relation("NcrVerifiedBy")
  createdActions          QualitySafetyAction[]      @relation("ActionCreatedBy")
  completedActions        QualitySafetyAction[]      @relation("ActionCompletedBy")
  verifiedActions         QualitySafetyAction[]      @relation("ActionVerifiedBy")
  reportedObservations    SafetyObservation[]        @relation("ObservationReportedBy")
  closedObservations      SafetyObservation[]        @relation("ObservationClosedBy")
  reportedIncidents       SafetyIncident[]           @relation("IncidentReportedBy")
  investigatedIncidents   SafetyIncident[]           @relation("IncidentInvestigatedBy")
  closedIncidents         SafetyIncident[]           @relation("IncidentClosedBy")
  createdEngineeringDocuments EngineeringDocument[]   @relation("EngineeringDocumentCreatedBy")
  createdDocumentVersions     DocumentVersion[]       @relation("DocumentVersionCreatedBy")
  issuedDocumentVersions      DocumentVersion[]       @relation("DocumentVersionIssuedBy")
  supersededDocumentVersions  DocumentVersion[]       @relation("DocumentVersionSupersededBy")
  sentTransmittals            DocumentTransmittal[]   @relation("TransmittalSender")
  acknowledgedTransmittals    DocumentTransmittal[]   @relation("TransmittalAcknowledgedBy")
  raisedRfis                  RequestForInformation[] @relation("RfiRaisedBy")
  assignedRfis                RequestForInformation[] @relation("RfiAssignedTo")
  respondedRfis               RequestForInformation[] @relation("RfiRespondedBy")
  closedRfis                  RequestForInformation[] @relation("RfiClosedBy")
  createdApprovalPolicies     ApprovalPolicy[]        @relation("ApprovalPolicyCreatedBy")
  submittedApprovalRequests   ApprovalRequest[]       @relation("ApprovalRequestSubmittedBy")
  decidedApprovals            ApprovalDecision[]      @relation("ApprovalDecisionActor")
  assignedAlerts              Alert[]                 @relation("AlertAssignedTo")
  acknowledgedAlerts          Alert[]                 @relation("AlertAcknowledgedBy")
  resolvedAlerts              Alert[]                 @relation("AlertResolvedBy")
  notificationDeliveries      NotificationDelivery[]
  createdIntegrations         IntegrationConnection[] @relation("IntegrationCreatedBy")
  aiRequests                  AIRequest[]             @relation("AIRequestRequestedBy")
  invitations                 UserInvitation[]        @relation("UserInvitations")
  sentInvitations             UserInvitation[]        @relation("InvitationsSent")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(50)
  version          Int       @default(1)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

// ==========================================
// PHASE 04 — RBAC, PERMISSIONS & SCOPING
// ==========================================

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(100) // COMPANY_OWNER, PROJECT_MANAGER, etc.
  displayName  String   @default("") @map("display_name") @db.VarChar(100)
  description  String?  @db.VarChar(255)
  isSystemRole Boolean  @default(true) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments UserRoleAssignment[]
  permissions RolePermissionMapping[]
  invitations UserInvitation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100) // domain:entity:action
  module      String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles RolePermissionMapping[]

  @@index([module])
  @@map("permissions")
}

model RolePermissionMapping {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  scopeType String   @default("TENANT") @map("scope_type") @db.VarChar(50) // TENANT, COMPANY, PROJECT
  scopeId   String?  @map("scope_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId, scopeType, scopeId])
  @@index([tenantId, userId])
  @@map("user_role_assignments")
}

model UserInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  email       String    @db.VarChar(255)
  roleId      String    @map("role_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.VarChar(255)
  status      String    @default("PENDING") @db.VarChar(50) // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  invitedById String    @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("UserInvitations", fields: [userId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy User   @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, tokenHash])
  @@index([tenantId, email, status])
  @@index([tenantId, status])
  @@index([userId])
  @@map("user_invitations")
}

model Project {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  code             String    @db.VarChar(50)
  name             String    @db.VarChar(255)
  description      String?   @db.Text
  projectType      String?   @map("project_type") @db.VarChar(100)
  location         String?   @db.VarChar(255)
  address          String?   @db.Text
  city             String?   @db.VarChar(100)
  state            String?   @db.VarChar(100)
  pincode          String?   @db.VarChar(20)
  status           String    @default("PLANNING") @db.VarChar(50) // PLANNING, ACTIVE, ON_HOLD, COMPLETED, ARCHIVED
  plannedStartDate DateTime? @map("planned_start_date") @db.Timestamptz
  plannedEndDate   DateTime? @map("planned_end_date") @db.Timestamptz
  actualStartDate  DateTime? @map("actual_start_date") @db.Timestamptz
  actualEndDate    DateTime? @map("actual_end_date") @db.Timestamptz
  estimatedBudget  Decimal?  @map("estimated_budget") @db.Decimal(15, 2)
  contractValue    Decimal?  @map("contract_value") @db.Decimal(15, 2)
  currency         String    @default("INR") @db.VarChar(10)
  siteAreaSqft     Decimal?  @map("site_area_sqft") @db.Decimal(12, 2)
  builtUpAreaSqft  Decimal?  @map("built_up_area_sqft") @db.Decimal(12, 2)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  members              ProjectMember[]
  stores               Store[]
  wbsNodes             WbsNode[]
  tasks                Task[]
  taskDependencies     TaskDependency[]
  dailyProgressReports DailyProgressReport[]
  materialIndents      MaterialIndent[]
  materialIndentSequences MaterialIndentSequence[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderSequences PurchaseOrderSequence[]
  goodsReceiptNotes    GoodsReceiptNote[]
  goodsReceiptSequences GoodsReceiptSequence[]
  materialIssues       MaterialIssue[]
  materialIssueSequences MaterialIssueSequence[]
  materialReturns      MaterialReturn[]
  materialReturnSequences MaterialReturnSequence[]
  sourceTransfers      MaterialTransfer[]   @relation("TransferSourceProject")
  destinationTransfers MaterialTransfer[]   @relation("TransferDestProject")
  inventoryReservations InventoryReservation[]
  boqItems             BoqItem[]
  digitalMbRecords     DigitalMbRecord[]
  digitalMbSequences   DigitalMbSequence[]
  expenseClaims        ExpenseClaim[]
  vendorInvoices       VendorInvoice[]
  raBills              RaBill[]
  paymentVouchers      PaymentVoucher[]
  advanceRecords       AdvanceRecord[]
  retentionRecords     RetentionRecord[]
  attendanceRecords    AttendanceRecord[]
  labourMusterRecords  LabourMusterRecord[]
  holidayCalendars     HolidayCalendar[]
  assignedEquipment    Equipment[]
  equipmentAssignments EquipmentAssignment[]
  equipmentOperatingLogs EquipmentOperatingLog[]
  equipmentFuelLogs    EquipmentFuelLog[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  inspectionRequests   InspectionRequest[]
  nonConformanceReports NonConformanceReport[]
  qualitySafetyActions QualitySafetyAction[]
  safetyObservations   SafetyObservation[]
  safetyIncidents      SafetyIncident[]
  qualitySafetyAuditLogs QualitySafetyAuditLog[]
  engineeringDocuments EngineeringDocument[]
  documentVersions     DocumentVersion[]
  documentTransmittals DocumentTransmittal[]
  documentTransmittalItems DocumentTransmittalItem[]
  rfis                 RequestForInformation[]
  rfiDocumentReferences RfiDocumentReference[]
  documentAuditLogs    DocumentAuditLog[]
  approvalPolicies     ApprovalPolicy[]
  approvalRequests     ApprovalRequest[]
  outboxEvents         OutboxEvent[]
  alerts               Alert[]
  aiInsights           AIInsight[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, companyId])
  @@index([tenantId, plannedStartDate])
  @@map("projects")
}

model ProjectMember {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  projectRole String   @default("MEMBER") @map("project_role") @db.VarChar(100)
  isLead      Boolean  @default(false) @map("is_lead")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([tenantId, userId])
  @@map("project_members")
}

model WbsNode {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  projectId           String                @map("project_id") @db.Uuid
  parentId            String?               @map("parent_id") @db.Uuid
  code                String                @db.VarChar(50) // e.g. "1.1", "1.1.2"
  name                String                @db.VarChar(255)
  description         String?               @db.Text
  level               Int                   @default(1)
  sequence            Int                   @default(0)
  status              String                @default("PLANNED") @db.VarChar(50) // PLANNED, IN_PROGRESS, COMPLETED, ON_HOLD
  weightagePct        Decimal?              @map("weightage_pct") @db.Decimal(5, 2)
  progressPct         Decimal               @default(0) @map("progress_pct") @db.Decimal(5, 2)
  plannedStartDate    DateTime?             @map("planned_start_date") @db.Timestamptz
  plannedEndDate      DateTime?             @map("planned_end_date") @db.Timestamptz
  actualStartDate     DateTime?             @map("actual_start_date") @db.Timestamptz
  actualEndDate       DateTime?             @map("actual_end_date") @db.Timestamptz
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent              WbsNode?              @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            WbsNode[]             @relation("WbsHierarchy")
  tasks               Task[]
  dprActivityProgress DprActivityProgress[]
  materialIndentLines MaterialIndentLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  materialIssueLines  MaterialIssueLine[]
  inventoryReservationLines InventoryReservationLine[]
  boqItems            BoqItem[]
  inspectionRequests  InspectionRequest[]
  engineeringDocuments EngineeringDocument[]
  rfis                RequestForInformation[]

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@index([projectId, parentId])
  @@map("wbs_nodes")
}

model Task {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  projectId           String                @map("project_id") @db.Uuid
  wbsNodeId           String?               @map("wbs_node_id") @db.Uuid
  name                String                @db.VarChar(255)
  description         String?               @db.Text
  status              String                @default("TODO") @db.VarChar(50) // TODO, IN_PROGRESS, COMPLETED, BLOCKED, CANCELLED
  priority            String                @default("MEDIUM") @db.VarChar(20) // LOW, MEDIUM, HIGH, URGENT
  isMilestone         Boolean               @default(false) @map("is_milestone")
  progressPct         Decimal               @default(0) @map("progress_pct") @db.Decimal(5, 2)
  plannedStartDate    DateTime?             @map("planned_start_date") @db.Timestamptz
  plannedEndDate      DateTime?             @map("planned_end_date") @db.Timestamptz
  actualStartDate     DateTime?             @map("actual_start_date") @db.Timestamptz
  actualEndDate       DateTime?             @map("actual_end_date") @db.Timestamptz
  assignedUserId      String?               @map("assigned_user_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsNode             WbsNode?              @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  assignedUser        User?                 @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  predecessors        TaskDependency[]      @relation("SuccessorTask")
  successors          TaskDependency[]      @relation("PredecessorTask")
  dprActivityProgress DprActivityProgress[]
  materialIndentLines MaterialIndentLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  materialIssueLines  MaterialIssueLine[]
  inventoryReservationLines InventoryReservationLine[]
  digitalMbRecords    DigitalMbRecord[]
  inspectionRequests  InspectionRequest[]
  engineeringDocuments EngineeringDocument[]
  rfis                RequestForInformation[]

  @@index([tenantId, projectId])
  @@index([projectId, wbsNodeId])
  @@index([tenantId, assignedUserId])
  @@map("tasks")
}

model TaskDependency {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  predecessorTaskId String   @map("predecessor_task_id") @db.Uuid
  successorTaskId   String   @map("successor_task_id") @db.Uuid
  dependencyType    String   @default("FS") @map("dependency_type") @db.VarChar(10) // FS, SS, FF, SF
  lagDays           Int      @default(0) @map("lag_days")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorTask Task    @relation("PredecessorTask", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask   Task    @relation("SuccessorTask", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([tenantId, projectId])
  @@index([projectId, predecessorTaskId])
  @@index([projectId, successorTaskId])
  @@map("task_dependencies")
}

model Store {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  branchId           String?  @map("branch_id") @db.Uuid
  projectId          String?  @map("project_id") @db.Uuid
  code               String   @db.VarChar(50)
  name               String   @db.VarChar(255)
  description        String?  @db.Text
  address            String?  @db.Text
  location           String?  @db.VarChar(255)
  isCentralWarehouse Boolean  @default(false) @map("is_central_warehouse")
  storeType          String   @default("PROJECT_SITE") @map("store_type") @db.VarChar(50) // CENTRAL, PROJECT_SITE
  status             String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, INACTIVE
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  accessAssignments   StoreAccessAssignment[]
  stockBalances       StoreStockBalance[]
  stockMovements      StockMovement[]
  materialIndents     MaterialIndent[]
  goodsReceiptNotes   GoodsReceiptNote[]
  materialIssues      MaterialIssue[]
  materialReturns     MaterialReturn[]
  dispatchedTransfers MaterialTransfer[]      @relation("TransferSourceStore")
  receivedTransfers   MaterialTransfer[]      @relation("TransferDestStore")
  inventoryReservations InventoryReservation[]
  dispensedFuelLogs   EquipmentFuelLog[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@map("stores")
}

model StoreAccessAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  accessLevel String   @default("FULL") @map("access_level") @db.VarChar(50) // FULL, READ_ONLY, ISSUE_ONLY
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([tenantId, userId])
  @@map("store_access_assignments")
}

// ==========================================
// PHASE 05 — SUBSCRIPTIONS & FEATURE ENTITLEMENTS
// ==========================================

model PlatformPlan {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(50) // STARTER, PROFESSIONAL, ENTERPRISE
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(255)
  maxProjects     Int?     @map("max_projects") // null = Unlimited (Legacy/Default)
  maxSeats        Int?     @map("max_seats")    // null = Unlimited (Legacy/Default)
  maxStorageGb    Int?     @map("max_storage_gb") // null = Unlimited / 5000 GB (Legacy/Default)
  priceMonthly    Decimal  @default(0) @map("price_monthly") @db.Decimal(12, 2)
  priceAnnual     Decimal  @default(0) @map("price_annual") @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  activeVersionId String?  @map("active_version_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  features      PlanFeature[]
  versions      PlatformPlanVersion[]
  subscriptions TenantSubscription[]

  @@map("platform_plans")
}

model PlatformPlanVersion {
  id            String    @id @default(uuid()) @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  versionNumber Int       @map("version_number")
  status        String    @default("DRAFT") @db.VarChar(50) // DRAFT, PUBLISHED, ARCHIVED
  priceMonthly  Decimal   @default(0) @map("price_monthly") @db.Decimal(12, 2)
  priceAnnual   Decimal   @default(0) @map("price_annual") @db.Decimal(12, 2)
  maxProjects   Int?      @map("max_projects") // null = Unlimited
  maxSeats      Int?      @map("max_seats")    // null = Unlimited
  maxStorageGb  Int?      @map("max_storage_gb") // null = 5000 GB
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  plan          PlatformPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  features      PlanVersionFeature[]
  subscriptions TenantSubscription[]

  @@unique([planId, versionNumber])
  @@index([planId, status])
  @@map("platform_plan_versions")
}

model PlanVersionFeature {
  id            String   @id @default(uuid()) @db.Uuid
  planVersionId String   @map("plan_version_id") @db.Uuid
  featureKey    String   @map("feature_key") @db.VarChar(100)
  isEnabled     Boolean  @default(true) @map("is_enabled")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  planVersion PlatformPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, featureKey])
  @@index([planVersionId])
  @@map("plan_version_features")
}

model PlanFeature {
  id         String   @id @default(uuid()) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key") @db.VarChar(100)
  isEnabled  Boolean  @default(true) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  plan PlatformPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
  @@map("plan_features")
}

model TenantSubscription {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  planVersionId      String?   @map("plan_version_id") @db.Uuid
  status             String    @default("ACTIVE") @db.VarChar(50) // TRIAL, ACTIVE, PAST_DUE, SUSPENDED, CANCELLED, EXPIRED
  billingCycle       String    @default("ANNUAL") @map("billing_cycle") @db.VarChar(20) // MONTHLY, ANNUAL
  currentPeriodStart DateTime  @default(now()) @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        PlatformPlan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  planVersion PlatformPlanVersion?        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  overrides   TenantEntitlementOverride[]

  @@index([tenantId, status])
  @@index([planVersionId])
  @@map("tenant_subscriptions")
}

model TenantEntitlementOverride {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  subscriptionId     String    @map("subscription_id") @db.Uuid
  featureKey         String    @map("feature_key") @db.VarChar(100)
  isEnabled          Boolean   @default(true) @map("is_enabled")
  additionalProjects Int?      @map("additional_projects")
  additionalSeats    Int?      @map("additional_seats")
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureKey])
  @@index([tenantId])
  @@map("tenant_entitlement_overrides")
}

model TenantWorkspaceModule {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  featureKey String   @map("feature_key") @db.VarChar(100)
  isEnabled  Boolean  @default(true) @map("is_enabled")
  updatedBy  String?  @map("updated_by") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@map("tenant_workspace_modules")
}

model PlatformAuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  timestamp        DateTime @default(now()) @map("timestamp") @db.Timestamptz
  actorId          String   @map("actor_id") @db.VarChar(100)
  action           String   @db.VarChar(100)
  targetTenantId   String?  @map("target_tenant_id") @db.Uuid
  targetTenantCode String?  @map("target_tenant_code") @db.VarChar(50)
  targetPlanId     String?  @map("target_plan_id") @db.Uuid
  targetPlanCode   String?  @map("target_plan_code") @db.VarChar(50)
  details          Json?    @db.JsonB
  ipAddress        String?  @map("ip_address") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([action, timestamp])
  @@index([targetPlanCode])
  @@index([targetTenantId])
  @@map("platform_audit_logs")
}

// ==========================================
// PHASE 06.3 — DAILY PROGRESS REPORTS (DPR)
// ==========================================

model DailyProgressReport {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  dprNumber       String    @map("dpr_number") @db.VarChar(50)
  reportDate      DateTime  @map("report_date") @db.Date
  status          String    @default("DRAFT") @db.VarChar(50) // DRAFT, SUBMITTED, APPROVED, REJECTED
  weather         String?   @db.VarChar(50)
  temperature     String?   @db.VarChar(50)
  shift           String?   @db.VarChar(50)
  safetyRemarks   String?   @map("safety_remarks") @db.Text
  delaysObstacles String?   @map("delays_obstacles") @db.Text
  generalNotes    String?   @map("general_notes") @db.Text
  createdById     String    @map("created_by_id") @db.Uuid
  submittedById   String?   @map("submitted_by_id") @db.Uuid
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz
  approvalRemarks String?   @map("approval_remarks") @db.Text
  rejectedById    String?   @map("rejected_by_id") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User                  @relation("DprCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy      User?                 @relation("DprSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy       User?                 @relation("DprApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy       User?                 @relation("DprRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  activityProgress DprActivityProgress[]
  manpowerLogs     DprManpower[]
  equipmentLogs    DprEquipment[]
  materialLogs     DprMaterial[]
  photos           DprPhoto[]
  digitalMbRecords DigitalMbRecord[]

  @@unique([projectId, reportDate])
  @@index([tenantId, projectId])
  @@index([projectId, status])
  @@index([tenantId, reportDate])
  @@map("daily_progress_reports")
}

model DprActivityProgress {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  dprId           String   @map("dpr_id") @db.Uuid
  taskId          String?  @map("task_id") @db.Uuid
  wbsNodeId       String?  @map("wbs_node_id") @db.Uuid
  activityName    String   @map("activity_name") @db.VarChar(255)
  workDescription String?  @map("work_description") @db.Text
  quantityDone    Decimal? @map("quantity_done") @db.Decimal(12, 2)
  unit            String?  @db.VarChar(50)
  progressPct     Decimal  @default(0) @map("progress_pct") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dpr     DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  task    Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  wbsNode WbsNode?            @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)

  @@index([tenantId, dprId])
  @@index([dprId])
  @@index([taskId])
  @@index([wbsNodeId])
  @@map("dpr_activity_progress")
}

model DprManpower {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  dprId           String   @map("dpr_id") @db.Uuid
  trade           String   @db.VarChar(100)
  skilledCount    Int      @default(0) @map("skilled_count")
  unskilledCount  Int      @default(0) @map("unskilled_count")
  supervisorCount Int      @default(0) @map("supervisor_count")
  remarks         String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dpr DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@index([tenantId, dprId])
  @@index([dprId])
  @@map("dpr_manpower")
}

model DprEquipment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  dprId          String   @map("dpr_id") @db.Uuid
  equipmentName  String   @map("equipment_name") @db.VarChar(255)
  operatingHours Decimal  @map("operating_hours") @db.Decimal(5, 2)
  status         String   @default("RUNNING") @db.VarChar(50) // RUNNING, IDLE, BREAKDOWN
  remarks        String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dpr DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@index([tenantId, dprId])
  @@index([dprId])
  @@map("dpr_equipment")
}

model DprMaterial {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  dprId            String   @map("dpr_id") @db.Uuid
  materialName     String   @map("material_name") @db.VarChar(255)
  quantityConsumed Decimal  @map("quantity_consumed") @db.Decimal(12, 2)
  unit             String   @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dpr DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)

  @@index([tenantId, dprId])
  @@index([dprId])
  @@map("dpr_materials")
}

model DprPhoto {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  dprId        String    @map("dpr_id") @db.Uuid
  photoUrl     String    @map("photo_url") @db.VarChar(1000)
  caption      String?   @db.VarChar(500)
  takenAt      DateTime? @map("taken_at") @db.Timestamptz
  latitude     Decimal?  @db.Decimal(10, 8)
  longitude    Decimal?  @db.Decimal(11, 8)
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  dpr        DailyProgressReport @relation(fields: [dprId], references: [id], onDelete: Cascade)
  uploadedBy User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId, dprId])
  @@index([dprId])
  @@map("dpr_photos")
}

// ==========================================
// PHASE 07 — MATERIALS / PROCUREMENT / INVENTORY
// ==========================================

model Material {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  itemCode         String   @map("item_code") @db.VarChar(50)
  name             String   @db.VarChar(255)
  description      String?  @db.Text
  category         String   @db.VarChar(100)
  specification    String?  @db.Text
  primaryUom       String   @map("primary_uom") @db.VarChar(20)
  secondaryUom     String?  @map("secondary_uom") @db.VarChar(20)
  conversionFactor Decimal? @map("conversion_factor") @db.Decimal(12, 4)
  hsnCode          String?  @map("hsn_code") @db.VarChar(20)
  standardRate     Decimal  @default(0) @map("standard_rate") @db.Decimal(12, 2)
  reorderLevel     Decimal  @default(0) @map("reorder_level") @db.Decimal(12, 2)
  safetyStock      Decimal  @default(0) @map("safety_stock") @db.Decimal(12, 2)
