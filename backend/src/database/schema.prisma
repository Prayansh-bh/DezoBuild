model Equipment {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  equipmentCode          String    @map("equipment_code") @db.VarChar(50)
  name                   String    @db.VarChar(255)
  category               String    @db.VarChar(100) // EARTHMOVING, LIFTING, CONCRETE, POWER_GENERATION, TRANSPORT_HAULAGE, COMPACTION_ROAD, PILING_FOUNDATION, UTILITY_MISC
  equipmentType          String    @map("equipment_type") @db.VarChar(100)
  manufacturer           String?   @db.VarChar(100)
  modelNumber            String?   @map("model_number") @db.VarChar(100)
  serialNumber           String?   @map("serial_number") @db.VarChar(100)
  yearOfManufacture      Int?      @map("year_of_manufacture")
  registrationNumber     String?   @map("registration_number") @db.VarChar(50)
  ownershipType          String    @default("OWNED") @map("ownership_type") @db.VarChar(50) // OWNED, RENTED, LEASED, SUBCONTRACTOR_SUPPLIED
  ownerVendorId          String?   @map("owner_vendor_id") @db.Uuid
  
  status                 String    @default("AVAILABLE") @db.VarChar(50) // AVAILABLE, ASSIGNED, UNDER_MAINTENANCE, BREAKDOWN, RETIRED, DISPOSED
  meterType              String    @default("HOURS") @map("meter_type") @db.VarChar(50) // HOURS, KILOMETERS
  currentMeterReading    Decimal   @default(0) @map("current_meter_reading") @db.Decimal(12, 2)
  
  fuelType               String?   @map("fuel_type") @db.VarChar(50) // DIESEL, PETROL, ELECTRIC, DUAL_FUEL, NONE
  fuelEfficiencyNorm     Decimal?  @map("fuel_efficiency_norm") @db.Decimal(8, 2)
  defaultHourlyRate      Decimal   @default(0) @map("default_hourly_rate") @db.Decimal(12, 2)
  monthlyRentalAmount    Decimal?  @map("monthly_rental_amount") @db.Decimal(15, 2)
  
  currentBranchId        String?   @map("current_branch_id") @db.Uuid // Home Depot / Base Yard
  currentProjectId       String?   @map("current_project_id") @db.Uuid // Read-only projection of active assignment
  
  insuranceExpiryDate    DateTime? @map("insurance_expiry_date") @db.Date
  fitnessExpiryDate      DateTime? @map("fitness_expiry_date") @db.Date
  pucExpiryDate          DateTime? @map("puc_expiry_date") @db.Date
  
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company                Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                 Branch?                @relation(fields: [currentBranchId], references: [id], onDelete: SetNull)
  currentProject         Project?               @relation(fields: [currentProjectId], references: [id], onDelete: SetNull)
  ownerVendor            Vendor?                @relation(fields: [ownerVendorId], references: [id], onDelete: SetNull)
  
  assignments            EquipmentAssignment[]
  operatingLogs          EquipmentOperatingLog[]
  fuelLogs               EquipmentFuelLog[]
  maintenanceSchedules   MaintenanceSchedule[]
  workOrders             MaintenanceWorkOrder[]
  auditLogs              EquipmentAuditLog[]
  inspectionRequests     InspectionRequest[]
  safetyObservations     SafetyObservation[]

