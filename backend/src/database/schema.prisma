  semiSkilledCount Int       @default(0) @map("semi_skilled_count")
  unskilledCount   Int       @default(0) @map("unskilled_count")
  supervisorCount  Int       @default(0) @map("supervisor_count")
  totalHeadcount   Int       @default(0) @map("total_headcount")
  regularHours     Decimal   @default(0) @map("regular_hours") @db.Decimal(5, 2)
  overtimeHours    Decimal   @default(0) @map("overtime_hours") @db.Decimal(5, 2)
