model AttendancePunch {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  punchTime      DateTime @map("punch_time") @db.Timestamptz
  punchType      String   @map("punch_type") @db.VarChar(20) // IN, OUT
  source         String   @default("ONLINE") @db.VarChar(50) // ONLINE, MOBILE, BIOMETRIC, MANUAL, IMPORT, REGULARIZED
  gpsLatitude    Decimal? @map("gps_latitude") @db.Decimal(10, 7)
  gpsLongitude   Decimal? @map("gps_longitude") @db.Decimal(10, 7)
