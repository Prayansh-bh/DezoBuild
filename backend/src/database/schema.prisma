model AttendanceRecord {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  shiftId          String?   @map("shift_id") @db.Uuid
  attendanceDate   DateTime  @map("attendance_date") @db.Date
  checkInTime      DateTime? @map("check_in_time") @db.Timestamptz
  checkOutTime     DateTime? @map("check_out_time") @db.Timestamptz
  totalWorkMinutes Int       @default(0) @map("total_work_minutes")
  lateMinutes      Int       @default(0) @map("late_minutes")
  earlyOutMinutes  Int       @default(0) @map("early_out_minutes")
  overtimeMinutes  Int       @default(0) @map("overtime_minutes")
  status           String    @default("PRESENT") @db.VarChar(50) // PRESENT, ABSENT, HALF_DAY, ON_LEAVE, HOLIDAY, WEEK_OFF, REGULARIZED
  source           String    @default("ONLINE") @db.VarChar(50)  // ONLINE, MOBILE, BIOMETRIC, MANUAL, IMPORT, SYSTEM
  isRegularized    Boolean   @default(false) @map("is_regularized")
  regularizationId String?   @map("regularization_id") @db.Uuid
  remarks          String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee        Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project         Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shift           ShiftMaster?               @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  regularization  AttendanceRegularization?  @relation("RecordRegularization", fields: [regularizationId], references: [id], onDelete: SetNull)
  regularizations AttendanceRegularization[] @relation("RecordTargetRegularizations")

  @@unique([tenantId, employeeId, attendanceDate])
  @@index([tenantId, attendanceDate])
  @@index([tenantId, projectId, attendanceDate])
  @@index([tenantId, employeeId, attendanceDate])
  @@map("attendance_records")
}

model AttendanceRegularization {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  attendanceRecordId String?   @map("attendance_record_id") @db.Uuid
  requestedDate      DateTime  @map("requested_date") @db.Date
  requestedCheckIn   DateTime? @map("requested_check_in") @db.Timestamptz
  requestedCheckOut  DateTime? @map("requested_check_out") @db.Timestamptz
  requestedStatus    String    @map("requested_status") @db.VarChar(50)
  reason             String    @db.Text
  status             String    @default("SUBMITTED") @db.VarChar(50) // SUBMITTED, APPROVED, REJECTED
  requestedById      String    @map("requested_by_id") @db.Uuid
  approvedById       String?   @map("approved_by_id") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz
  rejectionReason    String?   @map("rejection_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
